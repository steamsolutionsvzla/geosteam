# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR (FASTAPI)
# =============================================================================
PORT=0000
HOST=localhost
DEBUG=True

# =============================================================================
# CONEXIÓN A POSTGRESQL / POSTGIS
# (Estas variables las usa tu código FastAPI cuando corres en tu PC)
# =============================================================================
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Cadena de conexión asíncrona para asyncpg (usada en FastAPI)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# VARIABLES PARA DOCKER COMPOSE (GeoServer)
# IMPORTANTE: Estas deben coincidir EXACTAMENTE con las variables del compose
# =============================================================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# SEGURIDAD JWT (Para el Token)
# =============================================================================
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# CREDENCIALES DE ADMIN DE GEOSERVER
# Deben coincidir con el usuario admin configurado en el servicio "geoserver"
# de docker-compose.yml. Nunca subas los valores reales a git.
# =============================================================================
GEOSERVER_ADMIN_USER=
GEOSERVER_ADMIN_PASSWORD=

# =============================================================================
# EXTRA: usados solo por el script standalone backend/app/api/prueba.py
# (publicador masivo de capas). No los necesita el backend FastAPI.
# =============================================================================
GEOSERVER_URL=http://localhost:8080/geoserver/rest
GEOSERVER_WORKSPACE=
GEOSERVER_STORE=
DB_SCHEMA=