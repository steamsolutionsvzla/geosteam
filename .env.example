# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR (FASTAPI)
# =============================================================================
PORT=0000
HOST=localhost
DEBUG=True

# =============================================================================
# CONEXIÓN A POSTGRESQL / POSTGIS
# (Estas variables las usa tu código FastAPI cuando corres en tu PC)
# =============================================================================
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Cadena de conexión asíncrona para asyncpg (usada en FastAPI)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# VARIABLES PARA DOCKER COMPOSE (GeoServer)
# IMPORTANTE: Estas deben coincidir EXACTAMENTE con las variables del compose
# =============================================================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# =============================================================================
# SEGURIDAD JWT (Para el Token)
# =============================================================================
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60