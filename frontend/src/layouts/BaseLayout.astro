---
import '../styles/index.css';

const {
  title = 'GeoSteam — Geoportal territorial | Steam Solutions',
  description = 'GeoSteam reúne catastro, infraestructura y datos ambientales en un solo mapa vivo.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Bootstrap 5 (CDN) -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

  <!-- ============ NAV ============ -->
  <nav class="navbar navbar-expand-md navbar-geo fixed-top py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/#top">
        <svg width="30" height="27" viewBox="0 0 34 30" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="navMark" x1="2" y1="26" x2="30" y2="4" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#4ECDC4" />
              <stop offset="0.6" stop-color="#4A7FC5" />
              <stop offset="1" stop-color="#1E3A5F" />
            </linearGradient>
          </defs>
          <rect x="1" y="14" width="7" height="14" rx="3.5" transform="rotate(-35 1 14)" fill="url(#navMark)" />
          <rect x="10" y="6" width="7" height="18" rx="3.5" transform="rotate(-35 10 6)" fill="url(#navMark)" />
          <rect x="19" y="0" width="7" height="14" rx="3.5" transform="rotate(-35 19 0)" fill="url(#navMark)" />
        </svg>
        <span class="font-display fw-semibold fs-5 text-white">GeoSteam</span>
      </a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navMenu">
        <ul class="navbar-nav gap-md-4 mb-3 mb-md-0">
          <li class="nav-item"><a class="nav-link" href="/#top">Inicio</a></li>
          <li class="nav-item"><a class="nav-link" href="/#plataforma">Plataforma</a></li>
          <li class="nav-item"><a class="nav-link" href="/#capas">Capas</a></li>
          <li class="nav-item"><a class="nav-link" href="/#flujo">Cómo funciona</a></li>
          <li class="nav-item"><a class="nav-link" href="/#contacto">Contacto</a></li>
        </ul>
        <div class="d-flex gap-2 ms-md-4">
          <a href="/login" class="btn btn-outline-line">Iniciar sesión</a>
          <a href="/geoportal" class="btn btn-teal">Abrir geoportal</a>
        </div>
      </div>
    </div>
  </nav>

  <slot />

  <!-- ============ FOOTER ============ -->
  <footer>
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
      <div class="d-flex align-items-center gap-2">
        <svg width="24" height="21" viewBox="0 0 34 30" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="14" width="7" height="14" rx="3.5" transform="rotate(-35 1 14)" fill="url(#navMark)" />
          <rect x="10" y="6" width="7" height="18" rx="3.5" transform="rotate(-35 10 6)" fill="url(#navMark)" />
          <rect x="19" y="0" width="7" height="14" rx="3.5" transform="rotate(-35 19 0)" fill="url(#navMark)" />
        </svg>
        <span style="color:var(--mist); font-size:0.85rem;">
          GeoSteam — un producto de <span class="text-white">Steam Solutions</span>
        </span>
      </div>
      <div class="footer-links font-mono">
        <a href="/#plataforma">Plataforma</a>
        <a href="/#capas">Capas</a>
        <a href="/#flujo">Cómo funciona</a>
        <a href="/#contacto">Contacto</a>
      </div>
      <p class="font-mono small mb-0" style="color:var(--mist); opacity:0.5;">© 2026 Steam Solutions</p>
    </div>
  </footer>

  <!-- Coordenada flotante (usada por /scripts/index.js) -->
  <div id="coord-readout" class="font-mono"></div>

  <!-- Bootstrap JS (menú móvil) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Scripts globales (public/scripts) -->
  <script is:inline src="/scripts/geosteam-config.js"></script>
  <script is:inline src="/scripts/visit-tracker.js"></script>
  <script is:inline src="/scripts/index.js"></script>
</body>
</html>