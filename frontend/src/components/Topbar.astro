---
// ============================================================
//  Topbar — componente reutilizable para pantallas internas
//  Props:
//    - context:      texto tras la barra "/" (ej: "Panel de administrador")
//    - showGeoserver: muestra el botón de abrir GeoServer
// ============================================================
interface Props {
  context?: string;
  showGeoserver?: boolean;
}
const { context = 'Espacio de trabajo', showGeoserver = false } = Astro.props;
---

<header class="geo-topbar">

  <a href="/hub" class="geo-brand" aria-label="Steam Solutions — inicio">
    <svg class="brand-mark" width="30" height="27" viewBox="0 0 34 30"
         xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="brandMark" x1="2" y1="26" x2="30" y2="4" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#4ECDC4"/>
          <stop offset="0.6" stop-color="#4A7FC5"/>
          <stop offset="1" stop-color="#1E3A5F"/>
        </linearGradient>
      </defs>
      <rect x="1"  y="14" width="7" height="14" rx="3.5" transform="rotate(-35 1 14)"  fill="url(#brandMark)"/>
      <rect x="10" y="6"  width="7" height="18" rx="3.5" transform="rotate(-35 10 6)"  fill="url(#brandMark)"/>
      <rect x="19" y="0"  width="7" height="14" rx="3.5" transform="rotate(-35 19 0)"  fill="url(#brandMark)"/>
    </svg>

    <span class="brand-name font-display fw-semibold">Steam Solutions</span>
    <span class="brand-sep" aria-hidden="true">/</span>
    <span class="brand-context font-display">{context}</span>
  </a>

  <div class="geo-topbar-actions">

{showGeoserver && (
  <a id="btnGeoserver" class="btn-geoserver" href="#" target="_blank" rel="noopener">
    <img
      src="/images/geoserver-logo.png"
      alt=""
      class="geoserver-logo"
      width="18"
      height="18"
      aria-hidden="true"
    />
    <span>Abrir GeoServer</span>
  </a>
)}

    <div class="user-pill" id="userPill" aria-live="polite">
      <span class="user-avatar font-display" id="userInitial" aria-hidden="true">·</span>
      <span class="user-meta">
        <span class="user-name" id="userName">Cargando…</span>
        <span class="user-role font-mono" id="userRole">—</span>
      </span>
      <span class="user-status-dot" aria-hidden="true"></span>
    </div>

    <button type="button" id="logoutBtn" class="logout-btn" aria-label="Cerrar sesión">
      <span class="logout-shimmer" aria-hidden="true"></span>
      <svg class="logout-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      <span class="logout-text font-mono">Cerrar sesión</span>
    </button>

  </div>
</header>