---
// Earth.astro
// Planeta 3D del hero. Sin capas superpuestas.
---
<div class="earth-hero-stage" id="earth-stage">
  <canvas id="earth-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const MAPTILER_API_KEY = import.meta.env.PUBLIC_MAPTILER_API_KEY ?? 'TU_MAPTILER_API_KEY_AQUI';

  const stage = document.getElementById('earth-stage');
  const canvas = document.getElementById('earth-canvas') as HTMLCanvasElement | null;

  const soportaWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(
        window.WebGLRenderingContext &&
        (c.getContext('webgl') || c.getContext('experimental-webgl'))
      );
    } catch {
      return false;
    }
  })();

  if (stage && canvas && soportaWebGL) {
    initEarth(stage, canvas);
  }

  function latLonToVector3(lat: number, lon: number, radius: number) {
    const phi = (90 - lat) * (Math.PI / 180);
    const theta = (lon + 180) * (Math.PI / 180);
    const x = -radius * Math.sin(phi) * Math.cos(theta);
    const z =  radius * Math.sin(phi) * Math.sin(theta);
    const y =  radius * Math.cos(phi);
    return new THREE.Vector3(x, y, z);
  }

  function initEarth(stage: HTMLElement, canvas: HTMLCanvasElement) {
    const escenaReduceMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 0, 3.1);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    // ---- Iluminación ----
    scene.add(new THREE.AmbientLight(0xbfd8e8, 1.6));
    scene.add(new THREE.HemisphereLight(0xffffff, 0x5a7a99, 1.2));

    const sol = new THREE.DirectionalLight(0xffffff, 3.2);
    sol.position.set(5, 2, 5);
    scene.add(sol);

    const relleno = new THREE.DirectionalLight(0xffffff, 1.1);
    relleno.position.set(-5, -1, -3);
    scene.add(relleno);

    const luzDeBorde = new THREE.DirectionalLight(0x4ecdc4, 0.7);
    luzDeBorde.position.set(-4, -1, -2);
    scene.add(luzDeBorde);

    const textureLoader = new THREE.TextureLoader();

    const texturaColor = textureLoader.load(
      'https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg'
    );
    texturaColor.colorSpace = THREE.SRGBColorSpace;

    const texturaEspecular = textureLoader.load(
      'https://threejs.org/examples/textures/planets/earth_specular_2048.jpg'
    );

    texturaColor.onUpdate = () => canvas.classList.add('is-ready');

    const geometria = new THREE.SphereGeometry(1, 64, 64);

    const material = new THREE.MeshStandardMaterial({
      map: texturaColor,
      roughnessMap: texturaEspecular,
      roughness: 0.85,
      metalness: 0.0,
      emissive: new THREE.Color(0x2a4a66),
      emissiveIntensity: 0.35,
    });

    const tierra = new THREE.Mesh(geometria, material);
    tierra.rotation.z = THREE.MathUtils.degToRad(23.4);
    scene.add(tierra);

    // ---- Halo atmosférico ----
    const atmosfera = new THREE.Mesh(
      new THREE.SphereGeometry(1.035, 64, 64),
      new THREE.ShaderMaterial({
        transparent: true,
        side: THREE.BackSide,
        vertexShader: `
          varying vec3 vNormal;
          void main () {
            vNormal = normalize(normalMatrix * normal);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          varying vec3 vNormal;
          void main () {
            float intensidad = pow(max(0.45 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 0.0), 2.5);
            gl_FragColor = vec4(0.42, 0.88, 0.85, 1.0) * intensidad;
          }
        `,
      })
    );
    scene.add(atmosfera);

    // ---- Controles ----
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.rotateSpeed = 0.6;
    controls.minPolarAngle = Math.PI * 0.3;
    controls.maxPolarAngle = Math.PI * 0.7;
    controls.autoRotate = !escenaReduceMovimiento;
    controls.autoRotateSpeed = -0.35; // 👈 sentido invertido

    controls.addEventListener('start', () => {
      controls.autoRotate = false;
    });
    controls.addEventListener('end', () => {
      if (!escenaReduceMovimiento) controls.autoRotate = true;
    });

    // ---- Responsive ----
    function ajustarTamano() {
      const ancho = stage.clientWidth;
      const alto = stage.clientHeight;
      if (ancho === 0 || alto === 0) return;
      camera.aspect = ancho / alto;
      camera.updateProjectionMatrix();
      renderer.setSize(ancho, alto, false);
    }
    new ResizeObserver(ajustarTamano).observe(stage);
    ajustarTamano();

    let pestanaOculta = false;
    document.addEventListener('visibilitychange', () => {
      pestanaOculta = document.hidden;
    });

    // ---- Loop ----
    renderer.setAnimationLoop(() => {
      if (pestanaOculta) return;
      controls.update();
      renderer.render(scene, camera);
    });
  }
</script>